# --- Database ---
DATABASE_URL=postgres://user:password@host:5432/dbname
# Set to "false" only for local Postgres without SSL. Leave unset/true on Render.
PGSSL=true

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# --- CORS ---
# Comma-separated list of exact frontend origins allowed to call this API.
ALLOWED_ORIGINS=https://akuhir.github.io

# --- Photo storage (Cloudinary — recommended for persistence on Render) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# If Cloudinary vars above are left blank, photos are stored on local disk
# under /uploads instead. This works for local development, but Render's
# filesystem is ephemeral on redeploy/restart unless you attach a paid
# persistent disk — so Cloudinary is the recommended path for production.
PUBLIC_BASE_URL=http://localhost:4000

# --- Server ---
PORT=4000
